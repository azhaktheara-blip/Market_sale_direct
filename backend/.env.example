# Django Configuration
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS
ALLOWED_HOSTS=localhost,127.0.0.1,farmer-direct-backend.onrender.com,.onrender.com,.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://market-sale-direct.vercel.app

# Database (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Redis & Celery
REDIS_URL=redis://:PASSWORD@HOST:6379/0
CELERY_BROKER_URL=redis://:PASSWORD@HOST:6379/1

# Email Configuration (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=YOUR_SENDGRID_OR_SMTP_KEY
DEFAULT_FROM_EMAIL=FarmerDirect <noreply@farmerdirect.com>

# Google OAuth 2.0 & Frontend Domain
FRONTEND_URL=https://market-sale-direct.vercel.app
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ABA PayWay Gateway Configuration
ABA_PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
ABA_PAYWAY_MERCHANT_ID=YOUR_ABA_MERCHANT_ID
ABA_PAYWAY_API_KEY=YOUR_ABA_PAYWAY_API_KEY

# Marketplace Economics
MARKETPLACE_COMMISSION_PERCENTAGE=5.0
DEFAULT_DELIVERY_FEE=2.00
