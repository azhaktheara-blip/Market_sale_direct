# Django Secret Key
SECRET_KEY=django-insecure-production-super-secret-key-farmer-direct-2026

# Debug mode
DEBUG=True

# Allowed Hosts & CORS
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173

# Database Settings (PostgreSQL or SQLite fallback)
POSTGRES_DB=farmer_direct_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres123@db:5432/farmer_direct_db

# Redis & Celery
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Stripe & Payment Gateway Mock Keys
STRIPE_PUBLIC_KEY=pk_test_mock_farmerdirect_2026
STRIPE_SECRET_KEY=sk_test_mock_farmerdirect_2026
BAKONG_MERCHANT_ID=farmerdirect_bakong_merchant

# S3-Compatible Object Storage (AWS S3, Supabase Storage, Cloudflare R2, MinIO)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-southeast-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Sentry Error Tracking & Performance Monitoring (gated, no-op if unset)
