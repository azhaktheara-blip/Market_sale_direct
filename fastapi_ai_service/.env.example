# Server Port
PORT=8000
ENVIRONMENT=development

# AI API Keys (Provide either GEMINI_API_KEY or OPENAI_API_KEY)
# If using Google Gemini (Recommended for free tier / fast multimodal):
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# If using OpenAI (GPT-4o / GPT-4o-mini):
# OPENAI_API_KEY=sk-proj-YourOpenAIApiKeyHere

# CORS Settings for React Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://market-sale-direct.vercel.app

